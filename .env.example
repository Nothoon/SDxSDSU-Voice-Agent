# Copy to .env (never commit real values). All keys stay server-side.

PORT=3000
HOST=0.0.0.0
# Lock CORS to the UI origin once the frontend has a URL (defaults to *).
ALLOWED_ORIGIN=

# Coverage tracking: "mock" (SIMULATED, no credentials) or "claude".
COVERAGE_PROVIDER=mock
COVERAGE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# ElevenLabs (Vineet's adapter; server-side only, never sent to the browser).
ELEVENLABS_API_KEY=
