# Copy to .env (never commit real values). All keys stay server-side.

PORT=3000
HOST=0.0.0.0
# Lock CORS to the UI origin once the frontend has a URL (defaults to *).
ALLOWED_ORIGIN=

# Coverage tracking: "mock" (SIMULATED, no credentials) or "claude".
COVERAGE_PROVIDER=mock
COVERAGE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Slide/doc import (talking points + hints from an uploaded file): "openai", "claude", or "mock" (SIMULATED).
# Defaults to "openai" when OPENAI_API_KEY is set, then "claude" when COVERAGE_PROVIDER=claude or
# ANTHROPIC_API_KEY is set, otherwise "mock".
OUTLINE_PROVIDER=
OPENAI_API_KEY=
OPENAI_OUTLINE_MODEL=gpt-5.5
OUTLINE_MODEL=claude-opus-5-5

# ElevenLabs (Vineet's adapter; server-side only, never sent to the browser).
# VOICE_PROVIDER defaults to "elevenlabs" when a key is set, otherwise "mock" (SIMULATED).
VOICE_PROVIDER=
ELEVENLABS_API_KEY=
# Defaults shown; the voice ID is an ElevenLabs premade voice and is not yet verified live.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Pause length (0.3–3.0 s) that makes Scribe commit a final transcript segment.
ELEVENLABS_VAD_SILENCE_SECS=0.8
